# Copia este archivo a .env.local (no se sube al repositorio) y reinicia `npm run dev`.

# URL base del backend NestJS. Por defecto /api: en desarrollo el proxy de Vite lo
# redirige a URBAN_PULSE_PROXY_URL (http://localhost:3000 si no se define) y, en
# Docker, nginx lo redirige al servicio backend. Solo hace falta cambiarlo si la API
# se sirve en otro origen (en ese caso el backend debe permitir CORS).
VITE_BACKEND_URL=/api

# Destino del proxy /api de `npm run dev` (vite.config.ts).
URBAN_PULSE_PROXY_URL=http://localhost:3000

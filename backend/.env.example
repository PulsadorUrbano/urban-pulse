# Entorno de ejecución del backend. Copia este archivo a backend/.env.
# Usa development solo en local para habilitar los usuarios de prueba.
NODE_ENV=development

# Puerto HTTP. Con PORT=0, el sistema asigna un puerto libre.
PORT=3000

# Credenciales opcionales de Nest Observe.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Directorio de imágenes subidas por el backend en esta rama.
UPLOADS_DIRECTORY=uploads

# Secreto para firmar y verificar JWT: cambia este ejemplo fuera de desarrollo.
JWT_SECRET=urban-pulse-dev-secret
JWT_EXPIRES_IN=24h

# Conexión a PostgreSQL para Prisma y autenticación al ejecutar el backend localmente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urbanpulse_db?schema=public"

# Vacío: no sincroniza al arrancar. Opciones: dbpush o deploy.
DB_SYNC=

# Cloudinary: credenciales del panel de tu cuenta; nunca enviarlas al frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

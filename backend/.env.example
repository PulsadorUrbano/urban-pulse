# Entorno de ejecución del backend. Por defecto es 'production' si no se define;
# usa 'development' en local para habilitar el comportamiento solo-dev (seed del admin).
NODE_ENV=development

# Optional Nest Observe credentials. Leave blank when observability is not configured.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# JWT
# Secret used to sign access tokens. El valor de ejemplo es solo para desarrollo:
# en cualquier otro entorno debe sustituirse por un secreto propio y no compartido.
JWT_SECRET=urban-pulse-dev-secret
# Token lifetime, any value accepted by jsonwebtoken (e.g. 24h, 30m, 1d).
JWT_EXPIRES_IN=24h

# Cadena de conexión a PostgreSQL que usan el backend y el CLI de Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urbanpulse_db?schema=public"

# Sincronización del esquema con la BD al arrancar (desactivada por defecto):
#   dbpush  - `prisma db push`: crea/actualiza las tablas según schema.prisma (sin migraciones).
#   deploy  - `prisma migrate deploy`: aplica las migraciones de prisma/migrations.
#   (vacío) - no hace nada: la BD se gestiona solo con el CLI.
DB_SYNC=
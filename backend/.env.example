# Entorno de ejecución del backend. Por defecto es 'production' si no se define;
# usa 'development' en local para habilitar el comportamiento solo-dev (seed del admin).
NODE_ENV=development

# Optional Nest Observe credentials. Leave blank when observability is not configured.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# JWT
# Secret used to sign access tokens.
JWT_SECRET=urban-pulse-dev-secret
# Token lifetime, any value accepted by jsonwebtoken (e.g. 24h, 30m, 1d).
JWT_EXPIRES_IN=24h

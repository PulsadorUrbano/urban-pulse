# Entorno de ejecución del backend. Copia este archivo a backend/.env.
# Usa development solo en local para habilitar los usuarios de prueba.
NODE_ENV=development

# Puerto HTTP. Con PORT=0, el sistema asigna un puerto libre.
PORT=3000

# Credenciales opcionales de Nest Observe.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# JWT
# Secret used to sign access tokens. El valor de ejemplo es solo para desarrollo:
# en cualquier otro entorno debe sustituirse por un secreto propio y no compartido.
JWT_SECRET=urban-pulse-dev-secret
JWT_EXPIRES_IN=24h

# Conexión a PostgreSQL para Prisma y autenticación al ejecutar el backend localmente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urbanpulse_db?schema=public"

# Sincronización del esquema con la BD al arrancar (desactivada por defecto):
#   dbpush  - `prisma db push`: crea/actualiza las tablas según schema.prisma (sin migraciones).
#   deploy  - `prisma migrate deploy`: aplica las migraciones de prisma/migrations.
#   (vacío) - no hace nada: la BD se gestiona solo con el CLI.
DB_SYNC=

# Geocodificación inversa de direcciones (Nominatim / OpenStreetMap).
# Se limita a una petición por segundo por proceso y se cachean resultados en memoria.
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=UrbanPulse/1.0 (https://github.com/PulsadorUrbano/UrbanPulse)
NOMINATIM_TIMEOUT_MS=2500

# Fotos de incidencias en un bucket S3 privado.
S3_BUCKET=
S3_REGION=
# La cadena de credenciales por defecto del SDK usa el perfil local o estas variables.
# Configura los valores reales solo en tu entorno; no los subas a Git.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# CDN privada opcional para lectura de fotos. Completa las tres variables juntas.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_BASE64=

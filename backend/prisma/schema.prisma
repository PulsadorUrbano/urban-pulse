// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Temporary incident aggregate. No database or migrations are activated.
enum IncidentStatus {
  reported
  validated
  rejected
  assigned
}

enum IncidentPriority {
  low
  medium
  high
}

model Incident {
  id               String            @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  civicId          String            @db.Uuid
  categoryId       String?           @db.Uuid
  category         String?
  urbanAssetId     String?           @db.Uuid
  departmentId     String?           @db.Uuid
  teamId           String?           @db.Uuid
  technicianId     String?           @db.Uuid
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team             Team?             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  technician       users?            @relation("IncidentTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  status           IncidentStatus    @default(reported)
  priority         IncidentPriority  @default(low)
  createdAt        DateTime          @default(now())
  location         IncidentLocation?
  cambiosEstado    CambioEstado[]
  cambiosPrioridad CambioPrioridad[]

  @@index([departmentId])
  @@index([teamId])
  @@index([technicianId])
}

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  teams     Team[]
  incidents Incident[]
}

model Team {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  departmentId String       @db.Uuid
  department   Department   @relation(fields: [departmentId], references: [id])
  members      TeamMember[]
  incidents    Incident[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

model TeamMember {
  userId       String  @db.Uuid
  teamId       String  @db.Uuid
  isTechnician Boolean @default(false)
  user         users   @relation(fields: [userId], references: [id])
  team         Team    @relation(fields: [teamId], references: [id])

  @@id([userId, teamId])
  @@index([teamId])
}

model IncidentLocation {
  incidentId String   @id @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id])
  latitude   Float?
  longitude  Float?
  accuracy   Float?
  createdAt  DateTime @default(now())
}

// Historial temporal: actor declarado por el cliente, sin identidad verificada.
model CambioEstado {
  id            String         @id @default(uuid()) @db.Uuid
  incidenciaId  String         @map("incident_id") @db.Uuid
  incidencia    Incident       @relation(fields: [incidenciaId], references: [id])
  actorId       String         @map("user_id") @db.Uuid
  nuevoEstado   IncidentStatus @map("new_status")
  motivo        String         @map("cause")
  fechaCreacion DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([incidenciaId])
  @@index([fechaCreacion])
  @@map("status_changes")
}

// Decisiones manuales en memoria; actor declarado, sin identidad verificada.
model CambioPrioridad {
  id             String           @id @default(uuid()) @db.Uuid
  esManual       Boolean          @default(true) @map("is_manual")
  nuevaPrioridad IncidentPriority @map("new_priority")
  motivo         String           @map("cause")
  fechaCreacion  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  incidenciaId   String           @map("incident_id") @db.Uuid
  incidencia     Incident         @relation(fields: [incidenciaId], references: [id])
  actorId        String           @map("user_id") @db.Uuid

  @@index([incidenciaId])
  @@map("priority_changes")
}

// Identidad de token-backend; las incidencias siguen almacenándose en memoria.
enum profile_role {
  administrative
  department
  team
  technician
  civic
  admin
  analyst
}

model users {
  id                String       @id @default(uuid()) @db.Uuid
  username          String       @unique
  email             String       @unique
  password          String
  created_at        DateTime     @default(now())
  role              profile_role
  citizen           citizens?
  teamMemberships   TeamMember[]
  assignedIncidents Incident[]   @relation("IncidentTechnician")
}

model citizens {
  user_id    String   @id @db.Uuid
  phone      String?  @unique
  created_at DateTime @default(now())
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

# Copia este archivo a .env en la raíz antes de usar docker compose.
# Compose usa DB_* para PostgreSQL y pasa la configuración de API al backend.
DB_NAME=urbanpulse_db
DB_USER=postgres
DB_PASSWORD=change-me

# Usa production fuera del desarrollo local para evitar usuarios de prueba.
NODE_ENV=production

# API
API_PORT=3001

# Puerto local del servidor de desarrollo web (contenedor en el puerto 5173).
WEB_PORT=8080

# Servidor de desarrollo del frontend móvil.
EXPO_PORT=8081
# Para usar Expo Go en un teléfono físico, sustituye localhost por la IP LAN
# del equipo donde se ejecuta Docker.
MOBILE_HOST_IP=localhost
# Opcional: fija la URL de API que Expo incluirá en la app, por ejemplo:
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.20:3001

# Sustituye este valor por un secreto propio antes de compartir el entorno.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=24h

# Vacío: gestiona el esquema con el CLI. Opciones: dbpush o deploy.
DB_SYNC=

# Credenciales opcionales de Nest Observe.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# docker-compose.yml pasa API_PORT como PORT y construye DATABASE_URL a partir de DB_*.

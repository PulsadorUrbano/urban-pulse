# Copia este archivo a .env en la raíz antes de usar docker compose.
# Compose usa DB_* para PostgreSQL y pasa la configuración de API al backend.
DB_NAME=urbanpulse_db
DB_USER=postgres
DB_PASSWORD=change-me

# Usa production fuera del desarrollo local para evitar usuarios de prueba.
NODE_ENV=production

# API
API_PORT=3000

# Puerto local del frontend web (contenedor en el puerto 80).
WEB_PORT=8080

# Sustituye este valor por un secreto propio antes de compartir el entorno.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=24h

# Vacío: gestiona el esquema con el CLI. Opciones: dbpush o deploy.
# Opcional: DB_SYNC=deploy aplica las migraciones al arrancar el backend.
DB_SYNC=

# Geocodificación inversa (el backend envía solo las coordenadas).
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=UrbanPulse/1.0 (https://github.com/PulsadorUrbano/UrbanPulse)
NOMINATIM_TIMEOUT_MS=2500

# Fotos de incidencias en S3. Compose pasa este archivo al contenedor backend.
S3_BUCKET=
S3_REGION=
# Credenciales del backend local. Para credenciales temporales, define también SESSION_TOKEN.
# No guardar los valores reales en Git ni enviarlos por chat.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# CDN privada para lectura de fotos. Completa las tres variables juntas.
# Dominio asignado a la distribución (sin https://).
CLOUDFRONT_DOMAIN=
# ID de la clave pública incluida en el grupo de claves de confianza.
CLOUDFRONT_KEY_PAIR_ID=
# PEM de la clave privada codificado en base64, solo en el .env local.
CLOUDFRONT_PRIVATE_KEY_BASE64=

# Credenciales opcionales de Nest Observe.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# docker-compose.yml pasa API_PORT como PORT y construye DATABASE_URL a partir de DB_*.

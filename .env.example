# Copia este archivo a .env en la raíz antes de usar docker compose.
# Compose usa DB_* para PostgreSQL y pasa el resto al contenedor backend.
DB_NAME=urbanpulse_db
DB_USER=postgres
DB_PASSWORD=change-me

# Usa production fuera del desarrollo local para evitar usuarios de prueba.
NODE_ENV=production

# Sustituye este valor por un secreto propio antes de compartir el entorno.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=24h

# Vacío: gestiona el esquema con el CLI. Opciones: dbpush o deploy.
DB_SYNC=

# Credenciales opcionales de Nest Observe.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Directorio de imágenes subidas por el backend en esta rama.
UPLOADS_DIRECTORY=uploads

# docker-compose.yml define PORT=3000 y construye DATABASE_URL a partir de DB_*.

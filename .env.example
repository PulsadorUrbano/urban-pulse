# Copia este archivo a .env en la raíz antes de usar docker compose.
# Compose usa DB_* para PostgreSQL y pasa la configuración de API al backend.
DB_NAME=urbanpulse_db
DB_USER=postgres
DB_PASSWORD=change-me

# Usa production fuera del desarrollo local para evitar usuarios de prueba.
NODE_ENV=production

# API
API_PORT=3001

# Puerto local del frontend web (contenedor en el puerto 80).
WEB_PORT=8080

# Sustituye este valor por un secreto propio antes de compartir el entorno.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=24h

# Vacío: gestiona el esquema con el CLI. Opciones: dbpush o deploy.
DB_SYNC=

# Credenciales opcionales de Nest Observe.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# docker-compose.yml pasa API_PORT como PORT y construye DATABASE_URL a partir de DB_*.

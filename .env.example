# Variables que interpola docker-compose.yml. Copia este archivo a .env si quieres cambiarlas.
DB_NAME=urbanpulse_db
DB_USER=postgres
DB_PASSWORD=postgres

# Entorno del backend. Por defecto es 'production' si no se define;
# pon 'development' para que arranque el seed del admin de prueba.
NODE_ENV=development

# JWT (lo consume el backend: firma y verificación de tokens)
JWT_SECRET=urban-pulse-dev-secret
# Duración del token (acepta 24h, 30m, 1d, ...)
JWT_EXPIRES_IN=24h

# Sincronización del esquema al arrancar (opciones: dbpush | deploy | vacío)
DB_SYNC=dbpush

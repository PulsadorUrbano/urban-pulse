// Modelo físico. Fuente: Prisma y migraciones versionadas.
// Los CHECK y triggers SQL complementan las relaciones mostradas.
Enum IncidentStatus {
reported
  validated
  rejected
  assigned
  in_progress
  resolved
  reopened
  closed
}

Enum AddressDistrict {
centro
  este
  ciudad_jardin
  bailen_miraflores
  palma_palmilla
  cruz_del_humilladero
  carretera_de_cadiz
  churriana
  campanillas
  puerto_de_la_torre
  teatinos_universidad
}

Enum IncidentPriority {
low
  medium
  high
}

Enum profile_role {
administrative
  department
  team
  technician
  civic
  admin
  analyst
}

Table Incident {
  checks {
    `char_length(title) BETWEEN 4 AND 35` [name: 'Incident_title_length_check']
  }
  id uuid [pk]
  title varchar [not null]
  description varchar
  civicId uuid [not null]
  categoryId uuid
  urbanAssetId uuid
  departmentId uuid
  teamId uuid
  technicianId uuid
  status IncidentStatus [not null]
  priority IncidentPriority [not null]
  createdAt timestamp [not null]
}

Table Category {
  code varchar [not null, unique]
  isActive boolean [not null]
  id uuid [pk]
  name varchar [not null, unique]
  normalizedName varchar [not null, unique]
  createdAt timestamp [not null]
}

Table UrbanAsset {
  id uuid [pk]
  name varchar [unique]
}

Table Department {
  isActive boolean [not null]
  id uuid [pk]
  name varchar [not null, unique]
}

Table Team {
  indexes {
    (id, departmentId) [unique]
  }
  isActive boolean [not null]
  id uuid [pk]
  name varchar [not null]
  departmentId uuid [not null]
}

Table TeamMember {
  indexes {
    userId [unique]
    (userId, teamId) [pk]
  }
  isActive boolean [not null]
  userId uuid [not null]
  teamId uuid [not null]
  isTechnician boolean [not null]
}

Table IncidentLocation {
  incidentId uuid [pk]
  latitude double [not null]
  longitude double [not null]
  accuracy double
  createdAt timestamp [not null]
  addressId uuid
}

Table Address {
  indexes {
    (street, zipCode, district) [unique]
  }
  id uuid [pk]
  street varchar [not null]
  zipCode varchar [not null]
  district AddressDistrict [not null]
}

Table UrbanContext {
  id uuid [pk]
  locationId uuid [not null, unique]
  weather varchar
  traffic varchar
  mobility varchar
  environment varchar
  demography int
}

Table status_changes {
  id uuid [pk]
  incident_id uuid [not null]
  user_id uuid [not null]
  new_status IncidentStatus [not null]
  cause varchar [not null]
  created_at timestamp [not null]
}

Table priority_changes {
  id uuid [pk]
  is_manual boolean [not null]
  new_priority IncidentPriority [not null]
  cause varchar [not null]
  created_at timestamp [not null]
  incident_id uuid [not null]
  user_id uuid
}

Table users {
  isActive boolean [not null]
  id uuid [pk]
  username varchar [not null, unique]
  email varchar [not null, unique]
  password varchar [not null]
  created_at timestamp [not null]
  role profile_role [not null]
}

Table citizens {
  user_id uuid [pk]
  phone varchar [unique]
  created_at timestamp [not null]
}

Table DepartmentMember {
  userId uuid [pk]
  departmentId uuid [not null]
}

Table assignment_changes {
  id uuid [pk]
  incidenciaId uuid [not null]
  actorId uuid [not null]
  departamentoAnteriorId uuid
  equipoAnteriorId uuid
  tecnicoAnteriorId uuid
  departamentoNuevoId uuid
  equipoNuevoId uuid
  tecnicoNuevoId uuid
  motivo varchar
  fechaCreacion timestamp [not null]
}

Ref: Incident.civicId > citizens.user_id
Ref: Incident.categoryId > Category.id
Ref: Incident.urbanAssetId > UrbanAsset.id
Ref: Incident.departmentId > Department.id
Ref: Incident.(teamId, departmentId) > Team.(id, departmentId)
Ref: Incident.(technicianId, teamId) > TeamMember.(userId, teamId)
Ref: Team.departmentId > Department.id
Ref: TeamMember.userId > users.id
Ref: TeamMember.teamId > Team.id
Ref: IncidentLocation.incidentId > Incident.id
Ref: IncidentLocation.addressId > Address.id
Ref: UrbanContext.locationId > IncidentLocation.incidentId
Ref: status_changes.incident_id > Incident.id
Ref: status_changes.user_id > users.id
Ref: priority_changes.incident_id > Incident.id
Ref: priority_changes.user_id > users.id
Ref: citizens.user_id > users.id
Ref: DepartmentMember.userId > users.id
Ref: DepartmentMember.departmentId > Department.id
Ref: assignment_changes.incidenciaId > Incident.id
Ref: assignment_changes.actorId > users.id
Ref: assignment_changes.departamentoAnteriorId > Department.id
Ref: assignment_changes.equipoAnteriorId > Team.id
Ref: assignment_changes.tecnicoAnteriorId > users.id
Ref: assignment_changes.departamentoNuevoId > Department.id
Ref: assignment_changes.equipoNuevoId > Team.id
Ref: assignment_changes.tecnicoNuevoId > users.id
